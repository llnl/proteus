# Script mode (cmake -P): embed a shadow bitcode file into a C registration
# translation unit. Inputs: BITCODE_FILE, SOURCE_FILE, OUTPUT_FILE.
#
# The module id must match the id the Proteus host pass computes for this
# TU's fatbinary registration. The host pass uses the source file's
# filesystem unique id (getUniqueFileID); that value is not reproducible
# from CMake, so the registration keys on the source path and the runtime
# matches by suffix when exact lookup fails. PROTOTYPE: the keying contract
# is the first thing to validate on a CUDA machine (see the design doc).

if(NOT BITCODE_FILE OR NOT SOURCE_FILE OR NOT OUTPUT_FILE)
    message(FATAL_ERROR "embed script requires BITCODE_FILE, SOURCE_FILE, OUTPUT_FILE")
endif()

file(READ "${BITCODE_FILE}" BitcodeHex HEX)
string(LENGTH "${BitcodeHex}" HexLen)
math(EXPR ByteLen "${HexLen} / 2")

# 12 bytes per "0xAB, " entry; wrap lines for readability.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ByteArray "${BitcodeHex}")
string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],)" "\\1\n  " ByteArray "${ByteArray}")

get_filename_component(SourceName "${SOURCE_FILE}" NAME)

file(WRITE "${OUTPUT_FILE}" "/* Generated by ProteusNvccShadowEmbed.cmake -- do not edit.
 * Shadow device bitcode for ${SourceName}, registered at startup so the
 * Proteus runtime can specialize kernels NVCC compiled without bitcode. */
#include <stdint.h>

extern void __proteus_register_shadow_bitcode(const char *ModuleId,
                                              const void *Bitcode,
                                              uint64_t Size);

static const unsigned char ProteusShadowBitcode[] = {
  ${ByteArray}
};

__attribute__((constructor)) static void proteus_register_shadow(void) {
  __proteus_register_shadow_bitcode(\"${SOURCE_FILE}\", ProteusShadowBitcode,
                                    ${ByteLen});
}
")
